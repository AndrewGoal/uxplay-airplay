+/* Some CDNs reject or throttle the default "GStreamer souphttpsrc" User-Agent;
+ * present the one an Apple TV's media player sends instead. */
+static void hls_source_setup (GstElement *playbin, GstElement *source, gpointer user_data) {
+    (void) playbin; (void) user_data;
+    if (g_object_class_find_property (G_OBJECT_GET_CLASS (source), "user-agent")) {
+        g_object_set (source, "user-agent",
+                      "AppleCoreMedia/1.0.0.21L569 (Apple TV; U; CPU OS 17_4 like Mac OS X; en_us)",
+                      NULL);
+    }
+}
+
+/* Pin the audio sample rate in front of the sink: an HLS variant switch can
+ * change it, and the audio sink is then rebuilt, which can leave playback
+ * without sound while the video keeps going. */
+static GstElement *make_hls_audio_sink (void) {
+    GstElement *bin = gst_bin_new ("hls-audiobin");
+    GstElement *conv = gst_element_factory_make ("audioconvert", NULL);
+    GstElement *resample = gst_element_factory_make ("audioresample", NULL);
+    GstElement *capsfilter = gst_element_factory_make ("capsfilter", NULL);
+    GstElement *sink = gst_element_factory_make ("autoaudiosink", NULL);
+    if (!bin || !conv || !resample || !capsfilter || !sink) {
+        return NULL;
+    }
+    GstCaps *caps = gst_caps_new_simple ("audio/x-raw", "rate", G_TYPE_INT, 48000, NULL);
+    g_object_set (capsfilter, "caps", caps, NULL);
+    gst_caps_unref (caps);
+    gst_bin_add_many (GST_BIN (bin), conv, resample, capsfilter, sink, NULL);
+    if (!gst_element_link_many (conv, resample, capsfilter, sink, NULL)) {
+        return NULL;
+    }
+    GstPad *pad = gst_element_get_static_pad (conv, "sink");
+    GstPad *ghost = gst_ghost_pad_new ("sink", pad);
+    gst_pad_set_active (ghost, TRUE);
+    gst_element_add_pad (bin, ghost);
+    gst_object_unref (pad);
+    return bin;
+}
